  "blacklist": [
    {
      "id": "ad:recruit",
      "group": "adRecruit",
      "pattern": "招聘|求职|兼职|招全栈|诚聘|内推|hiring|we are hiring|join our team|career opportunit",
      "scope": "both"
    },
    {
      "id": "ad:relay",
      "group": "adRecruit",
      "pattern": "中转站|注册送|代充|限时优惠|api 中转|低价出|免费额度|薅羊毛",
      "scope": "both"
    },
    {
      "id": "ad:course",
      "group": "adRecruit",
      "pattern": "零基础|小白|保姆级|学完即就业|全网最全|入门教程|基础班|小学生|少儿|培训班|割韭菜|点赞收藏|通俗易懂版教学",
      "scope": "title"
    },
    {
      "id": "ad:resume",
      "group": "adRecruit",
      "pattern": "portfolio|internship|homework|examen|笔试|简历|面试练习|profile for|my resume",
      "scope": "title"
    },
    {
      "id": "damaged:objectObject",
      "group": "damaged",
      "pattern": "\\[object Object\\]",
      "scope": "both"
    },
    {
      "id": "cross:biomed",
      "group": "crossDomain",
      "pattern": "pathogen|antimicrobial|drosophila|molecular diffusion|clinical trial|syndrome|neural crest|reaction-diffusion|genomic sequenc|protein fold",
      "unlessStrongAi": true,
      "scope": "both"
    },
    {
      "id": "cross:power",
      "group": "crossDomain",
      "pattern": "power transformer|voltage transformer|current transformer|substation",
      "unlessStrongAi": true,
      "scope": "both"
    },
    {
      "id": "nonTech:hardware",
      "group": "nonTech",
      "pattern": "bike computer|eink bike|自行车码表|单片机温控",
      "scope": "title"
    },
    {
      "id": "nonTech:chitchat",
      "group": "nonTech",
      "pattern": "是不是一个常用语|自救群|拉群|互助群|额度已经消耗完|做了个.*站|头 1 个了吧",
      "scope": "title"
    },
    {
      "id": "damaged:emptyRepoDesc",
      "group": "damaged",
      "pattern": "[\\w.-]+/[\\w.-]+:\\s*$",
      "scope": "title",
      "_why": "DB-03 #148/#149：GitHub 仓库无 description 时标题形如 `owner/repo:`，正文空、无有效代码。冒号结尾即描述缺失。"
    },
    {
      "id": "hype:clickbait",
      "group": "hype",
      "pattern": "全网彻底炸锅|彻底炸锅|炸锅了|横空出世|神级案例|一次看完|彻底疯了|震惊|炸裂|王炸|一夜爆火|刷屏全网|全网疯传|惊呆|不看后悔",
      "scope": "title",
      "_why": "标题党/情绪炒作对两个 bot 都不可接受，故进全局黑名单而非 persona 红线。DB-03 #181/#194/#196 实证：这类内容天然堆满 AI 关键词，正向词越全它们分越高。"
    },
    {
      "id": "hype:listicle",
      "group": "hype",
      "pattern": "\\d+\\s*个(神级|案例|技巧|细节|方法|要点|秘密)|这\\s*\\d+\\s*个(细节|技巧|原因)|不是.{0,12}而是这",
      "scope": "title",
      "_why": "清单体标题党（DB-03 #183「真正让 AI Agent 失控的，不是模型，而是这 3 个细节」、#194「38个神级案例一次看完」）：偏观点杂谈与情绪放大，缺乏实证。"
    },
    {
      "id": "damaged:scrapeFragment",
      "group": "damaged",
      "pattern": "^\\S+\\s+\\d+(\\.\\d+)?\\s*$|^\\S+\\s+\\d+(\\.\\d+)?%\\s*$",
      "scope": "title",
      "_why": "真跑实测（2026-09-04）产出里出现 `llm-gemini 0.34`、`llm-anthropic 0.27` 这类抓取碎片被当成标题发布：它们恰好 15 码点过了 minTitleChars、含 llm 得 3 分过了 relevance。形态是「一个 slug + 一个数值」，是网页抓取把评分/版本号行误当标题，不是内容。"
    }
  ],
  "_eventStopwordsNote": "实体词聚类的通用词表。判据：事件标识必须是专有名词/产品名（Astra、K2 Horizon、FlashInfer），而通用话题词（agent、framework、safety、benchmark）不是——拿话题词聚类必然误并（实测：Microsoft Agent Framework 经 agent 与 Astra 报道撞车）。扩充后必跑 npm run probe:events 与 tests/eventCluster.test.ts 验证召回未退化。",
