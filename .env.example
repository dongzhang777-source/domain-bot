# 复制为 .env 后填入。全部可选——没有 LLM 和 Telegram 时，bot 用启发式打分 + 本地文件推送照常运行。

# OpenAI 兼容 LLM（价值打分/摘要）。可指向 fati-local-service、DeepSeek、oMLX 等
DOMAIN_BOT_LLM_BASE_URL=
DOMAIN_BOT_LLM_API_KEY=
DOMAIN_BOT_LLM_MODEL=

# Telegram 推送（带 👍/👎 反馈按钮）
DOMAIN_BOT_TELEGRAM_TOKEN=
DOMAIN_BOT_TELEGRAM_CHAT_ID=

# Jina Reader（r.jina.ai 自 2025 起需免费 key：https://jina.ai/reader）
DOMAIN_BOT_JINA_API_KEY=

# 调度间隔（毫秒，默认 3600000 = 每小时）
DOMAIN_BOT_POLL_MS=3600000
